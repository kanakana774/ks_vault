							"pm.test(\"ステータスコードは200\", () => {\r",
							"  pm.response.to.have.status(200);\r",
							"});\r",
							"pm.test(\"1件のみ登録されてること\", () => {\r",
							"  const jsonData = pm.response.json();\r",
							"  pm.expect(jsonData).to.be.an(\"array\");\r",
							"  pm.expect(Object.keys(jsonData).length).to.eql(1);\r",
							"});\r",
							"pm.test(\"レスポンスボディに正しいIDが含まれる\", () => {\r",
							"  const jsonData = pm.response.json();\r",
							"  pm.expect(jsonData[0].tagId).to.eql(parseInt(pm.environment.get(\"created_tag_id\")));\r",
