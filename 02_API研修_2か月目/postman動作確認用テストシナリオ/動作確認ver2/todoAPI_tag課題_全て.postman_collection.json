	"item": [
		{
			"name": "タグ新規作成_正常系",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"ステータスコードは201\", () => {\r",
							"  pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"const location = pm.response.headers.get(\"Location\");\r",
							"\r",
							"pm.test(\"Location ヘッダにID付きURLを含む\", () => {\r",
							"  pm.expect(location).to.match(/\\/tags\\/\\d+$/);\r",
							"});\r",
							"\r",
							"const idMatch = location.match(/\\/tags\\/(\\d+)$/);\r",
							"if (idMatch) {\r",
							"  pm.environment.set(\"created_tag_id\", idMatch[1]);\r",
							"  pm.environment.set(\"version\", 0);\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"name\":\"タグ新規作成_正常系\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:8080/tags",
